	[59, 46, 16, 1, 47, 17],
	[12, 151, 121, 7, 152, 122],
	[12, 75, 47, 26, 76, 48],
	[39, 54, 24, 14, 55, 25],
	[22, 45, 15, 41, 46, 16],
	[6, 151, 121, 14, 152, 122],
	[6, 75, 47, 34, 76, 48],
	[46, 54, 24, 10, 55, 25],
	[2, 45, 15, 64, 46, 16],
	[17, 152, 122, 4, 153, 123],
	[29, 74, 46, 14, 75, 47],
	[49, 54, 24, 10, 55, 25],
	[24, 45, 15, 46, 46, 16],
	[4, 152, 122, 18, 153, 123],
	[13, 74, 46, 32, 75, 47],
	[48, 54, 24, 14, 55, 25],
	[42, 45, 15, 32, 46, 16],
	[20, 147, 117, 4, 148, 118],
	[40, 75, 47, 7, 76, 48],
	[43, 54, 24, 22, 55, 25],
	[10, 45, 15, 67, 46, 16],
	[19, 148, 118, 6, 149, 119],
	[18, 75, 47, 31, 76, 48],
	[34, 54, 24, 34, 55, 25],
	[20, 45, 15, 61, 46, 16]
];
QRRSBlock.getRSBlocks = function(typeNumber, errorCorrectLevel) {
	var rsBlock = QRRSBlock.getRsBlockTable(typeNumber, errorCorrectLevel);
	if (rsBlock === undefined) {
		throw new Error("bad rs block @ typeNumber:" + typeNumber + "/errorCorrectLevel:" + errorCorrectLevel);
	}
	var length = rsBlock.length / 3;
	var list = [];
	for (var i = 0; i < length; i++) {
		var count = rsBlock[i * 3 + 0];
		var totalCount = rsBlock[i * 3 + 1];
		var dataCount  = rsBlock[i * 3 + 2];
		for (var j = 0; j < count; j++) {
			list.push(new QRRSBlock(totalCount, dataCount) );	
		}
	}
	return list;
};
QRRSBlock.getRsBlockTable = function(typeNumber, errorCorrectLevel) {
	switch(errorCorrectLevel) {
	case QRErrorCorrectLevel.L :
		return QRRSBlock.RS_BLOCK_TABLE[(typeNumber - 1) * 4 + 0];
	case QRErrorCorrectLevel.M :
		return QRRSBlock.RS_BLOCK_TABLE[(typeNumber - 1) * 4 + 1];
	case QRErrorCorrectLevel.Q :
		return QRRSBlock.RS_BLOCK_TABLE[(typeNumber - 1) * 4 + 2];
	case QRErrorCorrectLevel.H :
		return QRRSBlock.RS_BLOCK_TABLE[(typeNumber - 1) * 4 + 3];
	default :
		return undefined;
	}
};
module.exports = QRRSBlock;
};
defs["QRUtil"] = function(module, exports, req){
var QRMode = req('./QRMode');
var QRPolynomial = req('./QRPolynomial');
var QRMath = req('./QRMath');
var QRMaskPattern = req('./QRMaskPattern');
var QRUtil = {
    PATTERN_POSITION_TABLE : [
        [],
        [6, 18],
        [6, 22],
        [6, 26],
        [6, 30],
        [6, 34],
        [6, 22, 38],
        [6, 24, 42],
        [6, 26, 46],
        [6, 28, 50],
        [6, 30, 54],        
        [6, 32, 58],
        [6, 34, 62],
        [6, 26, 46, 66],
        [6, 26, 48, 70],
        [6, 26, 50, 74],
        [6, 30, 54, 78],
        [6, 30, 56, 82],
        [6, 30, 58, 86],
        [6, 34, 62, 90],
        [6, 28, 50, 72, 94],
        [6, 26, 50, 74, 98],
        [6, 30, 54, 78, 102],
        [6, 28, 54, 80, 106],
        [6, 32, 58, 84, 110],
        [6, 30, 58, 86, 114],
        [6, 34, 62, 90, 118],
        [6, 26, 50, 74, 98, 122],
        [6, 30, 54, 78, 102, 126],
        [6, 26, 52, 78, 104, 130],
        [6, 30, 56, 82, 108, 134],
        [6, 34, 60, 86, 112, 138],
        [6, 30, 58, 86, 114, 142],
        [6, 34, 62, 90, 118, 146],
        [6, 30, 54, 78, 102, 126, 150],
        [6, 24, 50, 76, 102, 128, 154],
        [6, 28, 54, 80, 106, 132, 158],
        [6, 32, 58, 84, 110, 136, 162],
        [6, 26, 54, 82, 110, 138, 166],
        [6, 30, 58, 86, 114, 142, 170]
    ],
    G15 : (1 << 10) | (1 << 8) | (1 << 5) | (1 << 4) | (1 << 2) | (1 << 1) | (1 << 0),
    G18 : (1 << 12) | (1 << 11) | (1 << 10) | (1 << 9) | (1 << 8) | (1 << 5) | (1 << 2) | (1 << 0),
    G15_MASK : (1 << 14) | (1 << 12) | (1 << 10)    | (1 << 4) | (1 << 1),
    getBCHTypeInfo : function(data) {
        var d = data << 10;
        while (QRUtil.getBCHDigit(d) - QRUtil.getBCHDigit(QRUtil.G15) >= 0) {
            d ^= (QRUtil.G15 << (QRUtil.getBCHDigit(d) - QRUtil.getBCHDigit(QRUtil.G15) ) );    
        }
        return ( (data << 10) | d) ^ QRUtil.G15_MASK;
    },
    getBCHTypeNumber : function(data) {
        var d = data << 12;
        while (QRUtil.getBCHDigit(d) - QRUtil.getBCHDigit(QRUtil.G18) >= 0) {
            d ^= (QRUtil.G18 << (QRUtil.getBCHDigit(d) - QRUtil.getBCHDigit(QRUtil.G18) ) );    
        }
        return (data << 12) | d;
    },
    getBCHDigit : function(data) {
        var digit = 0;
        while (data !== 0) {
            digit++;
            data >>>= 1;
        }
        return digit;
    },
    getPatternPosition : function(typeNumber) {
        return QRUtil.PATTERN_POSITION_TABLE[typeNumber - 1];
    },
    getMask : function(maskPattern, i, j) {
        switch (maskPattern) {
        case QRMaskPattern.PATTERN000 : return (i + j) % 2 === 0;
        case QRMaskPattern.PATTERN001 : return i % 2 === 0;
        case QRMaskPattern.PATTERN010 : return j % 3 === 0;
        case QRMaskPattern.PATTERN011 : return (i + j) % 3 === 0;
        case QRMaskPattern.PATTERN100 : return (Math.floor(i / 2) + Math.floor(j / 3) ) % 2 === 0;
        case QRMaskPattern.PATTERN101 : return (i * j) % 2 + (i * j) % 3 === 0;
        case QRMaskPattern.PATTERN110 : return ( (i * j) % 2 + (i * j) % 3) % 2 === 0;
        case QRMaskPattern.PATTERN111 : return ( (i * j) % 3 + (i + j) % 2) % 2 === 0;
        default :
            throw new Error("bad maskPattern:" + maskPattern);
        }
    },
    getErrorCorrectPolynomial : function(errorCorrectLength) {
        var a = new QRPolynomial([1], 0);
        for (var i = 0; i < errorCorrectLength; i++) {
            a = a.multiply(new QRPolynomial([1, QRMath.gexp(i)], 0) );
        }
        return a;
    },
    getLengthInBits : function(mode, type) {
        if (1 <= type && type < 10) {
            switch(mode) {
            case QRMode.MODE_NUMBER     : return 10;
            case QRMode.MODE_ALPHA_NUM  : return 9;
            case QRMode.MODE_8BIT_BYTE  : return 8;
            case QRMode.MODE_KANJI      : return 8;
            default :
                throw new Error("mode:" + mode);
            }
        } else if (type < 27) {
            switch(mode) {
            case QRMode.MODE_NUMBER     : return 12;
            case QRMode.MODE_ALPHA_NUM  : return 11;
            case QRMode.MODE_8BIT_BYTE  : return 16;
            case QRMode.MODE_KANJI      : return 10;
            default :
                throw new Error("mode:" + mode);
            }
        } else if (type < 41) {
            switch(mode) {
            case QRMode.MODE_NUMBER     : return 14;
            case QRMode.MODE_ALPHA_NUM  : return 13;
            case QRMode.MODE_8BIT_BYTE  : return 16;
            case QRMode.MODE_KANJI      : return 12;
            default :
                throw new Error("mode:" + mode);
            }
        } else {
            throw new Error("type:" + type);
        }
    },
    getLostPoint : function(qrCode) {
        var moduleCount = qrCode.getModuleCount();
        var lostPoint = 0;
        var row = 0; 
        var col = 0;
        for (row = 0; row < moduleCount; row++) {
            for (col = 0; col < moduleCount; col++) {
                var sameCount = 0;
                var dark = qrCode.isDark(row, col);
                for (var r = -1; r <= 1; r++) {
                    if (row + r < 0 || moduleCount <= row + r) {
                        continue;
                    }
                    for (var c = -1; c <= 1; c++) {
                        if (col + c < 0 || moduleCount <= col + c) {
                            continue;
                        }
                        if (r === 0 && c === 0) {
                            continue;
                        }
                        if (dark === qrCode.isDark(row + r, col + c) ) {
                            sameCount++;
                        }
                    }
                }
                if (sameCount > 5) {
                    lostPoint += (3 + sameCount - 5);
                }
            }
        }
        for (row = 0; row < moduleCount - 1; row++) {
            for (col = 0; col < moduleCount - 1; col++) {
                var count = 0;
                if (qrCode.isDark(row,     col    ) ) count++;
                if (qrCode.isDark(row + 1, col    ) ) count++;
                if (qrCode.isDark(row,     col + 1) ) count++;
                if (qrCode.isDark(row + 1, col + 1) ) count++;
                if (count === 0 || count === 4) {
                    lostPoint += 3;
                }
            }
        }
        for (row = 0; row < moduleCount; row++) {
            for (col = 0; col < moduleCount - 6; col++) {
                if (qrCode.isDark(row, col) && 
                        !qrCode.isDark(row, col + 1) && 
                         qrCode.isDark(row, col + 2) && 
                         qrCode.isDark(row, col + 3) && 
                         qrCode.isDark(row, col + 4) && 
                        !qrCode.isDark(row, col + 5) && 
                         qrCode.isDark(row, col + 6) ) {
                    lostPoint += 40;
                }
            }
        }
        for (col = 0; col < moduleCount; col++) {
            for (row = 0; row < moduleCount - 6; row++) {
                if (qrCode.isDark(row, col) &&
                        !qrCode.isDark(row + 1, col) &&
                         qrCode.isDark(row + 2, col) &&
                         qrCode.isDark(row + 3, col) &&
                         qrCode.isDark(row + 4, col) &&
                        !qrCode.isDark(row + 5, col) &&
                         qrCode.isDark(row + 6, col) ) {
                    lostPoint += 40;
                }
            }
        }
        var darkCount = 0;
        for (col = 0; col < moduleCount; col++) {
            for (row = 0; row < moduleCount; row++) {
                if (qrCode.isDark(row, col) ) {
                    darkCount++;
                }
            }
        }
        var ratio = Math.abs(100 * darkCount / moduleCount / moduleCount - 50) / 5;
        lostPoint += ratio * 10;
        return lostPoint;       
    }
};
module.exports = QRUtil;
};
defs["QRBitBuffer"] = function(module, exports, req){
function QRBitBuffer() {
	this.buffer = [];
	this.length = 0;
}
QRBitBuffer.prototype = {
	get : function(index) {
		var bufIndex = Math.floor(index / 8);
		return ( (this.buffer[bufIndex] >>> (7 - index % 8) ) & 1) == 1;
	},
	put : function(num, length) {
		for (var i = 0; i < length; i++) {
			this.putBit( ( (num >>> (length - i - 1) ) & 1) == 1);
		}
	},
	getLengthInBits : function() {
		return this.length;
	},
	putBit : function(bit) {
		var bufIndex = Math.floor(this.length / 8);
		if (this.buffer.length <= bufIndex) {
			this.buffer.push(0);
		}
		if (bit) {
			this.buffer[bufIndex] |= (0x80 >>> (this.length % 8) );
		}
		this.length++;
	}
};
module.exports = QRBitBuffer;
};
defs["QR8bitByte"] = function(module, exports, req){
var QRMode = req('./QRMode');
function QR8bitByte(data) {
	this.mode = QRMode.MODE_8BIT_BYTE;
	this.data = data;
}
QR8bitByte.prototype = {
	getLength : function() {
		return this.data.length;
	},
	write : function(buffer) {
		for (var i = 0; i < this.data.length; i++) {
			buffer.put(this.data.charCodeAt(i), 8);
		}
	}
};
module.exports = QR8bitByte;
};
defs["index"] = function(module, exports, req){
var QR8bitByte = req('./QR8bitByte');
var QRUtil = req('./QRUtil');
var QRPolynomial = req('./QRPolynomial');
var QRRSBlock = req('./QRRSBlock');
var QRBitBuffer = req('./QRBitBuffer');
function QRCode(typeNumber, errorCorrectLevel) {
	this.typeNumber = typeNumber;
	this.errorCorrectLevel = errorCorrectLevel;
	this.modules = null;
	this.moduleCount = 0;
	this.dataCache = null;
	this.dataList = [];
}
QRCode.prototype = {
	addData : function(data) {
		var newData = new QR8bitByte(data);
		this.dataList.push(newData);
		this.dataCache = null;
	},
	isDark : function(row, col) {
		if (row < 0 || this.moduleCount <= row || col < 0 || this.moduleCount <= col) {
			throw new Error(row + "," + col);
		}
		return this.modules[row][col];
	},
	getModuleCount : function() {
		return this.moduleCount;
	},
	make : function() {
		if (this.typeNumber < 1 ){
			var typeNumber = 1;
			for (typeNumber = 1; typeNumber < 40; typeNumber++) {
				var rsBlocks = QRRSBlock.getRSBlocks(typeNumber, this.errorCorrectLevel);
				var buffer = new QRBitBuffer();
				var totalDataCount = 0;
				for (var i = 0; i < rsBlocks.length; i++) {
					totalDataCount += rsBlocks[i].dataCount;
				}
				for (var x = 0; x < this.dataList.length; x++) {
					var data = this.dataList[x];
					buffer.put(data.mode, 4);
					buffer.put(data.getLength(), QRUtil.getLengthInBits(data.mode, typeNumber) );
					data.write(buffer);
				}
				if (buffer.getLengthInBits() <= totalDataCount * 8)
					break;
			}
			this.typeNumber = typeNumber;
		}
		this.makeImpl(false, this.getBestMaskPattern() );
	},
	makeImpl : function(test, maskPattern) {
		this.moduleCount = this.typeNumber * 4 + 17;
		this.modules = new Array(this.moduleCount);
		for (var row = 0; row < this.moduleCount; row++) {
			this.modules[row] = new Array(this.moduleCount);
			for (var col = 0; col < this.moduleCount; col++) {
				this.modules[row][col] = null;//(col + row) % 3;
			}
		}
		this.setupPositionProbePattern(0, 0);
		this.setupPositionProbePattern(this.moduleCount - 7, 0);
		this.setupPositionProbePattern(0, this.moduleCount - 7);
		this.setupPositionAdjustPattern();
		this.setupTimingPattern();
		this.setupTypeInfo(test, maskPattern);
		if (this.typeNumber >= 7) {
			this.setupTypeNumber(test);
		}
		if (this.dataCache === null) {
			this.dataCache = QRCode.createData(this.typeNumber, this.errorCorrectLevel, this.dataList);
		}
		this.mapData(this.dataCache, maskPattern);
	},
	setupPositionProbePattern : function(row, col)  {
		for (var r = -1; r <= 7; r++) {
			if (row + r <= -1 || this.moduleCount <= row + r) continue;
			for (var c = -1; c <= 7; c++) {
				if (col + c <= -1 || this.moduleCount <= col + c) continue;
				if ( (0 <= r && r <= 6 && (c === 0 || c === 6) ) || 
                     (0 <= c && c <= 6 && (r === 0 || r === 6) ) || 
                     (2 <= r && r <= 4 && 2 <= c && c <= 4) ) {
					this.modules[row + r][col + c] = true;
				} else {
					this.modules[row + r][col + c] = false;
				}
			}		
		}		
	},
	getBestMaskPattern : function() {
		var minLostPoint = 0;
		var pattern = 0;
		for (var i = 0; i < 8; i++) {
			this.makeImpl(true, i);
			var lostPoint = QRUtil.getLostPoint(this);
			if (i === 0 || minLostPoint >  lostPoint) {
				minLostPoint = lostPoint;
				pattern = i;
			}
		}
		return pattern;
	},
	createMovieClip : function(target_mc, instance_name, depth) {
		var qr_mc = target_mc.createEmptyMovieClip(instance_name, depth);
		var cs = 1;
		this.make();
		for (var row = 0; row < this.modules.length; row++) {
			var y = row * cs;
			for (var col = 0; col < this.modules[row].length; col++) {
				var x = col * cs;
				var dark = this.modules[row][col];
				if (dark) {
					qr_mc.beginFill(0, 100);
					qr_mc.moveTo(x, y);
					qr_mc.lineTo(x + cs, y);
					qr_mc.lineTo(x + cs, y + cs);
					qr_mc.lineTo(x, y + cs);
					qr_mc.endFill();
				}
			}
		}
		return qr_mc;
	},
	setupTimingPattern : function() {
		for (var r = 8; r < this.moduleCount - 8; r++) {
			if (this.modules[r][6] !== null) {
				continue;
			}
			this.modules[r][6] = (r % 2 === 0);
		}
		for (var c = 8; c < this.moduleCount - 8; c++) {
			if (this.modules[6][c] !== null) {
				continue;
			}
			this.modules[6][c] = (c % 2 === 0);
		}
	},
	setupPositionAdjustPattern : function() {
		var pos = QRUtil.getPatternPosition(this.typeNumber);
		for (var i = 0; i < pos.length; i++) {
			for (var j = 0; j < pos.length; j++) {
				var row = pos[i];
				var col = pos[j];
				if (this.modules[row][col] !== null) {
					continue;
				}
				for (var r = -2; r <= 2; r++) {
					for (var c = -2; c <= 2; c++) {
						if (Math.abs(r) === 2 || 
                            Math.abs(c) === 2 ||
                            (r === 0 && c === 0) ) {
							this.modules[row + r][col + c] = true;
						} else {
							this.modules[row + r][col + c] = false;
						}
					}
				}
			}
		}
	},
	setupTypeNumber : function(test) {
		var bits = QRUtil.getBCHTypeNumber(this.typeNumber);
        var mod;
		for (var i = 0; i < 18; i++) {
			mod = (!test && ( (bits >> i) & 1) === 1);
			this.modules[Math.floor(i / 3)][i % 3 + this.moduleCount - 8 - 3] = mod;
		}
		for (var x = 0; x < 18; x++) {
			mod = (!test && ( (bits >> x) & 1) === 1);
			this.modules[x % 3 + this.moduleCount - 8 - 3][Math.floor(x / 3)] = mod;
		}
	},
	setupTypeInfo : function(test, maskPattern) {
		var data = (this.errorCorrectLevel << 3) | maskPattern;
		var bits = QRUtil.getBCHTypeInfo(data);
        var mod;
		for (var v = 0; v < 15; v++) {
			mod = (!test && ( (bits >> v) & 1) === 1);
			if (v < 6) {
				this.modules[v][8] = mod;
			} else if (v < 8) {
				this.modules[v + 1][8] = mod;
			} else {
				this.modules[this.moduleCount - 15 + v][8] = mod;
			}
		}
		for (var h = 0; h < 15; h++) {
			mod = (!test && ( (bits >> h) & 1) === 1);
			if (h < 8) {
				this.modules[8][this.moduleCount - h - 1] = mod;
			} else if (h < 9) {
				this.modules[8][15 - h - 1 + 1] = mod;
			} else {
				this.modules[8][15 - h - 1] = mod;
			}
		}
		this.modules[this.moduleCount - 8][8] = (!test);
	},
	mapData : function(data, maskPattern) {
		var inc = -1;
		var row = this.moduleCount - 1;
		var bitIndex = 7;
		var byteIndex = 0;
		for (var col = this.moduleCount - 1; col > 0; col -= 2) {
			if (col === 6) col--;
			while (true) {
				for (var c = 0; c < 2; c++) {
					if (this.modules[row][col - c] === null) {
						var dark = false;
						if (byteIndex < data.length) {
							dark = ( ( (data[byteIndex] >>> bitIndex) & 1) === 1);
						}
						var mask = QRUtil.getMask(maskPattern, row, col - c);
						if (mask) {
							dark = !dark;
						}
						this.modules[row][col - c] = dark;
						bitIndex--;
						if (bitIndex === -1) {
							byteIndex++;
							bitIndex = 7;
						}
					}
				}
				row += inc;
				if (row < 0 || this.moduleCount <= row) {
					row -= inc;
					inc = -inc;
					break;
				}
			}
		}
	}
};
QRCode.PAD0 = 0xEC;
QRCode.PAD1 = 0x11;
QRCode.createData = function(typeNumber, errorCorrectLevel, dataList) {
	var rsBlocks = QRRSBlock.getRSBlocks(typeNumber, errorCorrectLevel);
	var buffer = new QRBitBuffer();
	for (var i = 0; i < dataList.length; i++) {
		var data = dataList[i];
		buffer.put(data.mode, 4);
		buffer.put(data.getLength(), QRUtil.getLengthInBits(data.mode, typeNumber) );
		data.write(buffer);
	}
	var totalDataCount = 0;
	for (var x = 0; x < rsBlocks.length; x++) {
		totalDataCount += rsBlocks[x].dataCount;
	}
	if (buffer.getLengthInBits() > totalDataCount * 8) {
		throw new Error("code length overflow. (" + 
            buffer.getLengthInBits() + 
            ">" +  
            totalDataCount * 8 + 
            ")");
	}
	if (buffer.getLengthInBits() + 4 <= totalDataCount * 8) {
		buffer.put(0, 4);
	}
	while (buffer.getLengthInBits() % 8 !== 0) {
		buffer.putBit(false);
	}
	while (true) {
		if (buffer.getLengthInBits() >= totalDataCount * 8) {
			break;
		}
		buffer.put(QRCode.PAD0, 8);
		if (buffer.getLengthInBits() >= totalDataCount * 8) {
			break;
		}
		buffer.put(QRCode.PAD1, 8);
	}
	return QRCode.createBytes(buffer, rsBlocks);
};
QRCode.createBytes = function(buffer, rsBlocks) {
	var offset = 0;
	var maxDcCount = 0;
	var maxEcCount = 0;
	var dcdata = new Array(rsBlocks.length);
	var ecdata = new Array(rsBlocks.length);
	for (var r = 0; r < rsBlocks.length; r++) {
		var dcCount = rsBlocks[r].dataCount;
		var ecCount = rsBlocks[r].totalCount - dcCount;
		maxDcCount = Math.max(maxDcCount, dcCount);
		maxEcCount = Math.max(maxEcCount, ecCount);
		dcdata[r] = new Array(dcCount);
		for (var i = 0; i < dcdata[r].length; i++) {
			dcdata[r][i] = 0xff & buffer.buffer[i + offset];
		}
		offset += dcCount;
		var rsPoly = QRUtil.getErrorCorrectPolynomial(ecCount);
		var rawPoly = new QRPolynomial(dcdata[r], rsPoly.getLength() - 1);
		var modPoly = rawPoly.mod(rsPoly);
		ecdata[r] = new Array(rsPoly.getLength() - 1);
		for (var x = 0; x < ecdata[r].length; x++) {
            var modIndex = x + modPoly.getLength() - ecdata[r].length;
			ecdata[r][x] = (modIndex >= 0)? modPoly.get(modIndex) : 0;
		}
	}
	var totalCodeCount = 0;
	for (var y = 0; y < rsBlocks.length; y++) {
		totalCodeCount += rsBlocks[y].totalCount;
	}
	var data = new Array(totalCodeCount);
	var index = 0;
	for (var z = 0; z < maxDcCount; z++) {
		for (var s = 0; s < rsBlocks.length; s++) {
			if (z < dcdata[s].length) {
				data[index++] = dcdata[s][z];
			}
		}
	}
	for (var xx = 0; xx < maxEcCount; xx++) {
		for (var t = 0; t < rsBlocks.length; t++) {
			if (xx < ecdata[t].length) {
				data[index++] = ecdata[t][xx];
			}
		}
	}
	return data;
};
module.exports = QRCode;
};
var QRCode = req("index"), LEVELS = req("QRErrorCorrectLevel");
window.qrcode = function (type, level) {
  var q = new QRCode(type, LEVELS[level || "M"]);
  return {
    addData: function (d) { q.addData(d); },
    make: function () { q.make(); },
    getModuleCount: function () { return q.getModuleCount(); },
    isDark: function (r, c) { return q.isDark(r, c); }
  };
};
})();
</script>
<script>
/* ===== Nội dung — sửa lời chúc tại đây =====
   Mã QR chứa CHÍNH nội dung này, nên quét bằng camera nào cũng đọc ra thư.
   Thư càng ngắn thì mã QR càng thưa và càng dễ quét. */
const MESSAGE = `Nhân ngày Nhà giáo Việt Nam 20/11, em xin gửi đến Thầy Cô lời cảm ơn chân thành và những lời chúc tốt đẹp nhất.

Cảm ơn Thầy Cô vì đã luôn tận tâm dìu dắt, kiên nhẫn truyền đạt tri thức và tiếp thêm động lực để chúng em tự tin trên hành trình trưởng thành.

Kính chúc Thầy Cô thật nhiều sức khỏe, niềm vui và luôn giữ mãi ngọn lửa nhiệt huyết với nghề. Mong rằng mỗi ngày đến lớp đều là một ngày đầy ý nghĩa.

Chúng em xin chân thành cảm ơn!`;

/* Chữ rơi quanh thiệp — sửa hoặc thêm chữ tại đây */
const WORDS = ["20/11", "Cảm ơn Thầy Cô", "Tri ân", "Biết ơn", "Kính yêu", "Tận tâm", "Nhà giáo Việt Nam", "Chúc mừng 20/11", "Tôn sư trọng đạo", "Người lái đò", "Yêu thương", "Sức khỏe", "Hạnh phúc", "Thầy Cô ♡"];

const CAPTIONS = {
  qr: "Quét mã để đọc thư · hoặc chạm vào mã để các ô gộp thành phong thư ✉",
  envelope: "Chạm vào phong thư để quay lại mã QR · bấm “Mở thư” để đọc ♡",
  open: "Chạm vào lá thư để kéo ra đọc ♡"
};
const MORPH_MS = 2800;

/* Mỗi lần quay về QR sẽ đổi sang bảng màu mới. Màu QR đều đủ đậm để quét được.
   qr: các màu rải ngẫu nhiên lên ô dữ liệu · finder: 3 ô vuông góc · env: các mảng màu của phong bì */
const THEMES = [
  /* — Nhẹ nhàng (pastel): QR dùng tông vừa phải để vẫn quét được — */
  { finder: "#7566d0", qr: ["#7566d0", "#d6588a", "#3f9a96", "#cf7f3a", "#5a82cf"],
    env: { back: "#f08fba", foldL: "#f9c0da", foldR: "#f5a9cc", foldB: "#e57aa8", flap: "#b79cf0", seal: "#d9588a" } },
  { finder: "#3f9a96", qr: ["#3f9a96", "#5a82cf", "#d6588a", "#7566d0", "#b98a2e"],
    env: { back: "#6fcdb5", foldL: "#b5ecdc", foldR: "#98e2cd", foldB: "#4fb89d", flap: "#ff9db9", seal: "#e0527f" } },
  { finder: "#cf5f86", qr: ["#cf5f86", "#cf7f3a", "#7566d0", "#3f9a96", "#5a82cf"],
    env: { back: "#ffb877", foldL: "#ffd9ae", foldR: "#ffc78f", foldB: "#f59a4d", flap: "#ff8fae", seal: "#e0517d" } },
  /* — Rực rỡ — */
  { finder: "#e11d6a", qr: ["#e11d6a", "#7c3aed", "#2563eb", "#0d9488", "#ea580c"],
    env: { back: "#7c3aed", foldL: "#b794f6", foldR: "#9f7aea", foldB: "#6d28d9", flap: "#ff5c93", seal: "#e02f6e" } },
  { finder: "#0369a1", qr: ["#0284c7", "#0d9488", "#e11d48", "#7c3aed", "#d97706"],
    env: { back: "#0891b2", foldL: "#67d4e8", foldR: "#4cc3d9", foldB: "#0e7490", flap: "#ff7a59", seal: "#e11d48" } },
  { finder: "#c026d3", qr: ["#dc2626", "#ea580c", "#c026d3", "#4f46e5", "#0f766e"],
    env: { back: "#f97316", foldL: "#ffb067", foldR: "#ff9a4a", foldB: "#ea6a0f", flap: "#e11d6a", seal: "#be123c" } },
  { finder: "#16a34a", qr: ["#16a34a", "#db2777", "#2563eb", "#9333ea", "#ca8a04"],
    env: { back: "#22a06b", foldL: "#7be0a6", foldR: "#5dd18f", foldB: "#16875a", flap: "#ff6fa5", seal: "#db2777" } },
  { finder: "#e11d6a", qr: ["#1d4ed8", "#e11d6a", "#0284c7", "#7c3aed", "#0d9488"],
    env: { back: "#3b82f6", foldL: "#86c0ff", foldR: "#6fb0ff", foldB: "#4a98f8", flap: "#ff5c93", seal: "#e02f6e" } }
];
const ENV_KEYS = ["back", "foldL", "foldR", "foldB", "flap", "seal"];
let qrTheme = 0, envTheme = 0;

const CW = 400, CH = 440;
const CX = CW / 2, CY = CH / 2;
const QR_SIZE = 292;
const ENV_W = 320, ENV_H = 210;
const TARGET_CELL = 8;
const FOCAL = 700;
const GLYPHS = "20/11TRIÂNTHẦYCÔ✿♡";

const hex = h => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));
const lerp = (a, b, k) => a + (b - a) * k;
const clamp255 = v => Math.max(0, Math.min(255, v));
const ease = p => p * p * p * (p * (6 * p - 15) + 10);

function themeData(theme) {
  return theme._d || (theme._d = {
    qrRgb: theme.qr.map(hex), finderRgb: hex(theme.finder),
    envRgb: ENV_KEYS.map(k => hex(theme.env[k]))
  });
}

function envelopeRegion(x, v) {
  const u = x + ENV_W / 2;
  if (Math.hypot(x, v - 113) < 23) return 5;
  if (v < 126 * (1 - Math.abs(x) / 160)) return 4;
  if (v > 97 + 113 * Math.abs(x) / 160) return 3;
  const fold = 166 * Math.min(v / 113, (ENV_H - v) / 97);
  if (u < fold) return 1;
  if (ENV_W - u < fold) return 2;
  return 0;
}

function makeQRMatrix(text) {
  const qr = qrcode(0, "L");
  qr.addData(unescape(encodeURIComponent(text)), "Byte");
  qr.make();
  return { n: qr.getModuleCount(), isDark: (r, c) => qr.isDark(r, c) };
}

let particles = [], cellSize = 3;

function buildParticles(qr) {
  const n = qr.n, cs = QR_SIZE / n, half = QR_SIZE / 2;
  const isFinder = (r, c) => (r < 7 && c < 7) || (r < 7 && c >= n - 7) || (r >= n - 7 && c < 7);
  const sources = [], targets = [];

  for (let r = 0; r < n; r++)
    for (let c = 0; c < n; c++)
      if (qr.isDark(r, c))
        sources.push({ x: (c + .5) * cs - half, y: (r + .5) * cs - half, finder: isFinder(r, c), ci: Math.floor(Math.random() * 5) });

  const cols = Math.floor(ENV_W / TARGET_CELL), rows = Math.floor(ENV_H / TARGET_CELL);
  for (let r = 0; r < rows; r++)
    for (let c = 0; c < cols; c++) {
      const x = (c + .5 - cols / 2) * TARGET_CELL, y = (r + .5 - rows / 2) * TARGET_CELL;
      targets.push({ x, y, region: envelopeRegion(x, y + ENV_H / 2), jit: Math.round((Math.random() - .5) * 18), ch: GLYPHS[(c + r * 3) % GLYPHS.length] });
    }

  const total = Math.max(sources.length, targets.length);
  let prev = -1;
  cellSize = cs;
  particles = Array.from({ length: total }, (_, i) => {
    const s = sources[Math.floor(i * sources.length / total)];
    const ti = Math.floor(i * targets.length / total);
    const t = targets[ti];
    const primary = ti !== prev;
    prev = ti;
    return {
      sx: s.x, sy: s.y, finder: s.finder, ci: s.ci, tx: t.x, ty: t.y, region: t.region, jit: t.jit, ch: t.ch, primary,
      delay: Math.hypot(s.x, s.y) / (QR_SIZE * .71) * .32 + Math.random() * .06,
      jx: (Math.random() - .5) * 24, jy: (Math.random() - .5) * 24
    };
  });
}

let px = 0, py = 0, ps = 1;
function project(x, y, z) { ps = FOCAL / (FOCAL + z); px = CX + x * ps; py = CY + y * ps; }

const canvas = document.getElementById("cells"), ctx = canvas.getContext("2d");
const dpr = Math.min(devicePixelRatio || 1, 2);
canvas.width = CW * dpr; canvas.height = CH * dpr;
ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
ctx.textAlign = "center"; ctx.textBaseline = "middle";

function drawSquare(x, y, z, size, color) {
  project(x, y, z);
  const w = size * ps + .3;
  ctx.fillStyle = color;
  ctx.fillRect(px - w / 2, py - w / 2, w, w);
}

const items = [];
const SHADOWS = Array.from({ length: 17 }, (_, i) => `rgba(60,30,120,${(.16 * i / 16).toFixed(3)})`);

function draw(t) {
  ctx.clearRect(0, 0, CW, CH);
  const qrT = themeData(THEMES[qrTheme]), envT = themeData(THEMES[envTheme]);
  ctx.font = "9px ui-monospace, Consolas, monospace";
  const themeKey = qrTheme * 16 + envTheme;
  let n = 0;

  for (const p of particles) {
    const progress = Math.max(0, Math.min(1, (t - p.delay) / .6));
    const e = ease(progress), arc = Math.sin(progress * Math.PI);
    const glyph = p.primary && e > .45 ? Math.min(1, (e - .45) / .4) : 0;
    const s0 = p.finder ? cellSize + .35 : cellSize * .82;
    const size = p.primary ? lerp(s0, TARGET_CELL * .8, e) : s0 * (1 - e);
    if (size < .2 && glyph === 0) continue;

    const x0 = lerp(p.sx, p.tx, e), y0 = lerp(p.sy, p.ty, e);
    const x = x0 - (y0 / 160) * arc * 70 + arc * p.jx;
    const y = y0 + (x0 / 160) * arc * 70 + arc * p.jy;
    const z = -arc * 55;

    const qe = (e * 24) | 0;
    if (p.qe !== qe || p.qk !== themeKey) {
      const from = p.finder ? qrT.finderRgb : qrT.qrRgb[p.ci], to = envT.envRgb[p.region];
      p.col = `rgb(${Math.round(lerp(from[0], clamp255(to[0] + p.jit), e))},${Math.round(lerp(from[1], clamp255(to[1] + p.jit), e))},${Math.round(lerp(from[2], clamp255(to[2] + p.jit), e))})`;
      p.qe = qe; p.qk = themeKey;
    }
    const it = items[n] || (items[n] = {});
    it.x = x; it.y = y; it.z = z; it.arc = arc; it.size = size; it.glyph = glyph; it.ch = p.ch; it.color = p.col;
    n++;
  }
  items.length = n;

  for (const it of items) {
    if (it.glyph < 1 && it.size >= .2) {
      if (it.arc > .03) { ctx.globalAlpha = 1; drawSquare(it.x, it.y, 0, it.size, SHADOWS[(it.arc * 16) | 0]); }
      ctx.globalAlpha = 1 - it.glyph;
      drawSquare(it.x, it.y, it.z, it.size, it.color);
    }
    if (it.glyph > 0) {
      project(it.x, it.y, it.z);
      ctx.globalAlpha = it.glyph;
      ctx.fillStyle = it.color;
      ctx.fillText(it.ch, px, py);
    }
  }
  ctx.globalAlpha = 1;
  window.__drawn = true;
}

const stage = document.getElementById("stage");
const caption = document.getElementById("caption");
let view = "qr", t = 0, goal = 0, swing = 1, settling = false, clock = 0, last = performance.now();
let readTimer, capTimer, wasReady = false, pulse = 0, dirty = true, drawnT = -1;
const floatEl = document.querySelector(".float");

function setCaption(text) {
  clearTimeout(capTimer);
  caption.classList.add("out");
  capTimer = setTimeout(() => { caption.textContent = text; if (text) caption.classList.remove("out"); }, 320);
}
function burstAtBox(n) {
  const r = document.getElementById("box").getBoundingClientRect();
  burst(r.left + r.width / 2, r.top + r.height * .5, n);
}

function frame(now) {
  const dt = Math.min(now - last, 100);
  last = now; clock += dt / 1000;

  const step = dt / MORPH_MS;
  t = goal > t ? Math.min(goal, t + step) : Math.max(goal, t - step);

  const swingGoal = view === "open" || settling ? 0 : 1;
  swing += (swingGoal - swing) * Math.min(1, dt / 240);
  if (settling && swing < .12) { settling = false; setView("open"); }
  const isReady = view === "envelope" && t === 1 && !settling;
  stage.classList.toggle("ready", isReady);
  if (isReady && !wasReady) burstAtBox(26);
  wasReady = isReady;
  const pulsing = (view === "envelope" && t === 1) || (view === "open" && !stage.classList.contains("read"));
  pulse += ((pulsing ? 1 : 0) - pulse) * Math.min(1, dt / (pulsing ? 500 : 250));
  const beat = 1 + pulse * .028 * Math.sin(clock * 2.6);
  floatEl.style.transform = `translateY(${(-(1 - Math.cos(clock * 1.5708)) / 2 * 5 * swing).toFixed(2)}px) scale(${beat.toFixed(4)})`;

  if (!stage.classList.contains("formed")) {
    canvas.style.transform = `perspective(700px) rotateY(${(Math.sin(clock * .6) * .14 * swing).toFixed(4)}rad) rotateX(${(-.05 * swing).toFixed(4)}rad)`;
    if (t !== drawnT || dirty) { draw(t); drawnT = t; dirty = false; }
  }
  try { fxStep(now); } catch (e) {}
  requestAnimationFrame(frame);
}

function applyEnvTheme() {
  const env = THEMES[envTheme].env, set = (k, v) => stage.style.setProperty(k, v);
  set("--e-back", env.back); set("--e-fl", env.foldL); set("--e-fr", env.foldR);
  set("--e-fb", env.foldB); set("--e-flap", env.flap); set("--e-seal", env.seal);
}

function setView(next) {
  if (next === "qr" && view !== "qr") qrTheme = (qrTheme + 1) % THEMES.length;
  if (next === "envelope" && view === "qr") { envTheme = qrTheme; applyEnvTheme(); }
  view = next;
  dirty = true;
  stage.dataset.view = next;
  stage.classList.remove("read");
  setCaption(CAPTIONS[next]);
  clearTimeout(readTimer);
  if (next === "qr") { stage.classList.remove("formed"); goal = 0; }
  if (next === "envelope") { stage.classList.remove("formed"); goal = 1; }
  if (next === "open") stage.classList.add("formed");
}
function requestOpen() {
  settling = true;
  setCaption("");
}
function onBoxActivate() {
  if (settling) return;
  if (view === "qr") setView("envelope");
  else if (view === "envelope") setView("qr");
}

document.querySelector(".env").addEventListener("click", () => {
  if (view !== "open" || stage.classList.contains("read")) return;
  stage.classList.add("read");
  setCaption("");
  burstAtBox(34);
});

const box = document.getElementById("box");
let boxRect = { left: 0, top: 0, width: 0, height: 0 };
box.addEventListener("click", onBoxActivate);
box.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); onBoxActivate(); } });
document.getElementById("openBtn").addEventListener("click", () => {
  if (view === "envelope" && t === 1 && !settling) requestOpen();
});
document.getElementById("backBtn").addEventListener("click", () => {
  if (view === "open") setView("envelope");
});

document.getElementById("msg").textContent = MESSAGE;

let qrMatrix = null;
function syncFallback() {
  try {
    const q = qrMatrix, S = 6, Q = 4, N = (q.n + 2 * Q) * S;
    const c = document.createElement("canvas"), g = c.getContext("2d");
    c.width = c.height = N;
    g.fillStyle = "#fff"; g.fillRect(0, 0, N, N); g.fillStyle = "#000";
    for (let r = 0; r < q.n; r++) for (let k = 0; k < q.n; k++) if (q.isDark(r, k)) g.fillRect((k + Q) * S, (r + Q) * S, S, S);
    document.getElementById("fbQR").src = c.toDataURL();
  } catch (e) {}
}

function init() {
  if (typeof qrcode !== "function") { caption.textContent = "Không tải được mã QR, vui lòng tải lại trang."; return; }
  qrMatrix = makeQRMatrix(MESSAGE);
  buildParticles(qrMatrix);
  caption.textContent = CAPTIONS.qr;
  requestAnimationFrame(frame);
  if (new URLSearchParams(location.search).has("card")) {
    t = goal = 1; setView("envelope");
    setTimeout(requestOpen, 700);
  }
}
init();
setTimeout(syncFallback, 1500);

function fitStage() {
  const hdr = document.querySelector(".title").offsetHeight;
  const s = Math.max(.4, Math.min(1.3, innerWidth / 350, (innerHeight - hdr - 28) / 540));
  stage.style.transform = `scale(${s})`;
  const wrap = document.getElementById("wrap");
  wrap.style.width = 340 * s + "px";
  wrap.style.height = 540 * s + "px";
  boxRect = box.getBoundingClientRect();
}
addEventListener("resize", fitStage);
addEventListener("orientationchange", () => setTimeout(fitStage, 200));
fitStage();
if (document.fonts) { document.fonts.ready.then(fitStage); if (document.fonts.addEventListener) document.fonts.addEventListener("loadingdone", fitStage); }

const DPR = Math.min(devicePixelRatio || 1, 1.5);
const REDUCED = matchMedia("(prefers-reduced-motion: reduce)").matches;
const cv = document.getElementById("petals"), pctx = cv.getContext("2d");
const fxCv = document.getElementById("fx"), fctx = fxCv.getContext("2d");
let W = innerWidth, H = innerHeight;
const rnd = (a, b) => a + Math.random() * (b - a);

function makePetalSprite([deep, mid, light]) {
  const S = 96, c = document.createElement("canvas");
  c.width = c.height = S;
  const g = c.getContext("2d"), L = S * .46;
  g.translate(S / 2, S / 2);
  g.beginPath();
  g.moveTo(0, -L);
  g.bezierCurveTo(L * .55, -L * .5, L * 1.0, L * .1, L * .55, L * .78);
  g.quadraticCurveTo(L * .25, L * 1.0, 0, L * .7);
  g.quadraticCurveTo(-L * .25, L * 1.0, -L * .55, L * .78);
  g.bezierCurveTo(-L * 1.0, L * .1, -L * .55, -L * .5, 0, -L);
  g.closePath();
  const body = g.createLinearGradient(0, -L, 0, L);
  body.addColorStop(0, deep); body.addColorStop(.5, mid); body.addColorStop(1, light);
  g.fillStyle = body; g.fill();
  g.save(); g.clip();
  const gloss = g.createRadialGradient(-L * .25, L * .25, 0, -L * .25, L * .25, L * .8);
  gloss.addColorStop(0, "rgba(255,255,255,.7)"); gloss.addColorStop(1, "rgba(255,255,255,0)");
  g.fillStyle = gloss; g.fillRect(-S, -S, S * 2, S * 2);
  g.restore();
  g.strokeStyle = "rgba(255,255,255,.6)"; g.lineWidth = 1.4; g.stroke();
  g.beginPath(); g.moveTo(0, -L * .85); g.lineTo(0, L * .45);
  g.strokeStyle = "rgba(255,255,255,.4)"; g.lineWidth = 1; g.stroke();
  return c;
}

function makeSparkle(glow, tip) {
  const S = 64, c = document.createElement("canvas");
  c.width = c.height = S;
  const g = c.getContext("2d");
  g.translate(S / 2, S / 2);
  const halo = g.createRadialGradient(0, 0, 0, 0, 0, 30);
  halo.addColorStop(0, `rgba(${glow},.55)`); halo.addColorStop(.4, `rgba(${glow},.16)`); halo.addColorStop(1, `rgba(${glow},0)`);
  g.fillStyle = halo; g.beginPath(); g.arc(0, 0, 30, 0, 6.2832); g.fill();
  const star = (R, r, rot, alpha) => {
    g.save(); g.rotate(rot); g.globalAlpha = alpha;
    g.beginPath(); g.moveTo(0, -R);
    g.quadraticCurveTo(r, -r, R, 0); g.quadraticCurveTo(r, r, 0, R);
    g.quadraticCurveTo(-r, r, -R, 0); g.quadraticCurveTo(-r, -r, 0, -R);
    const f = g.createRadialGradient(0, 0, 0, 0, 0, R);
    f.addColorStop(0, "#fff"); f.addColorStop(.45, "#fffbe8"); f.addColorStop(1, tip);
    g.fillStyle = f; g.fill(); g.restore();
  };
  star(29, 3.4, 0, 1); star(15, 2.4, Math.PI / 4, .85);
  g.fillStyle = "#fff"; g.beginPath(); g.arc(0, 0, 3.2, 0, 6.2832); g.fill();
  return c;
}

const PETAL_SPRITES = [
  ["#ff5c96", "#ff9dbf", "#ffe0ec"], ["#ff3d7f", "#ff82ad", "#ffcadd"], ["#4f9bff", "#94c6ff", "#e0efff"],
  ["#a688f4", "#c9b6ff", "#f0e9ff"], ["#ffa8c8", "#ffd0e1", "#fff4f8"]
].map(makePetalSprite);
const SPARKLES = [makeSparkle("255,200,80", "#ffbf3d"), makeSparkle("255,130,175", "#ff6fa5"), makeSparkle("110,175,255", "#5aa2ff")];

function drawSprite(c, img, x, y, size, rot, alpha) {
  c.save(); c.globalAlpha = alpha; c.translate(x, y); c.rotate(rot);
  c.drawImage(img, -size / 2, -size / 2, size, size); c.restore();
}

function newPetal(anywhere) {
  const z = rnd(.55, 1.25);
  return {
    x: rnd(-20, W + 20), y: anywhere ? rnd(-20, H) : rnd(-60, -15), z, s: rnd(12, 22) * z, vy: rnd(.35, .8) * z,
    sway: rnd(0, 6.28), sv: rnd(.012, .03), amp: rnd(.25, .7), rot: rnd(0, 6.28), vr: rnd(-.012, .012),
    flip: rnd(0, 6.28), fv: rnd(.02, .06), sp: Math.floor(rnd(0, PETAL_SPRITES.length)),
    tw: rnd(0, 6.28), tv: rnd(.02, .05), si: Math.floor(rnd(0, 3)), a: Math.min(1, .55 + z * .35)
  };
}
function newStar(anywhere) {
  return { x: rnd(0, W), y: anywhere ? rnd(0, H) : rnd(-20, 0), s: rnd(10, 22), ph: rnd(0, 6.28), pv: rnd(.02, .05), vy: rnd(.08, .22), rot: rnd(0, 6.28), si: Math.floor(rnd(0, 3)) };
}

const k = REDUCED ? .4 : 1;
let petals = Array.from({ length: Math.round(Math.min(48, Math.max(26, W / 26)) * k) }, () => newPetal(true));
let stars = Array.from({ length: Math.round(Math.min(34, Math.max(18, W / 36)) * k) }, () => newStar(true));
let bits = [], fxLast = performance.now();

const WORD_COLORS = [["#ff4f8b", "#ff9dbf"], ["#3b8bff", "#7cc0ff"], ["#c026d3", "#ff7ac6"], ["#f59e0b", "#ffcf5a"], ["#0d9488", "#5ad6c3"]];
let words = [], wordSprites = [], wordIdx = 0, qrHide = 1;

function makeWordSprite(text, [c1, c2]) {
  const f = 56, pad = 14, font = `600 ${f}px "Dancing Script", "Segoe Script", cursive`;
  const m = document.createElement("canvas").getContext("2d");
  m.font = font;
  const w = Math.ceil(m.measureText(text).width) + pad * 2, h = f + pad * 2;
  const c = document.createElement("canvas");
  c.width = w; c.height = h;
  const g = c.getContext("2d");
  g.font = font; g.textAlign = "center"; g.textBaseline = "middle"; g.lineJoin = "round";
  g.lineWidth = 9; g.strokeStyle = "rgba(255,255,255,.85)"; g.shadowColor = c1; g.shadowBlur = 14;
  g.strokeText(text, w / 2, h / 2 + 2);
  g.shadowBlur = 0;
  const grad = g.createLinearGradient(0, pad, 0, h - pad);
  grad.addColorStop(0, c2); grad.addColorStop(1, c1);
  g.fillStyle = grad; g.fillText(text, w / 2, h / 2 + 2);
  return c;
}
function newWord(anywhere) {
  const z = rnd(.7, 1.2), small = Math.min(1, W / 430);
  return {
    sp: wordSprites[wordIdx++ % wordSprites.length], x: rnd(W * .08, W * .92), y: anywhere ? rnd(-40, H) : rnd(-90, -40), z,
    sc: rnd(.3, .45) * z * (.8 + .2 * small), vy: rnd(.22, .45) * z, sway: rnd(0, 6.28), sv: rnd(.008, .016),
    amp: rnd(.35, .8), a: .5 + .3 * (z - .7) / .5
  };
}
function buildWords() {
  wordSprites = WORDS.map((t, i) => makeWordSprite(t, WORD_COLORS[i % WORD_COLORS.length])).sort(() => Math.random() - .5);
  words = Array.from({ length: Math.round((W < 500 ? 8 : 13) * k) }, () => newWord(true));
}
const fontLink = document.getElementById("gf");
new Promise(res => {
  if (!fontLink || fontLink.dataset.loaded) return res();
  fontLink.addEventListener("load", res); setTimeout(res, 2500);
}).then(() => document.fonts ? document.fonts.load('600 40px "Dancing Script"', "Cảm ơn Thầy Cô ầ ệ ữ ớ") : 0).catch(() => {}).then(buildWords);

function sizeFx() {
  W = innerWidth; H = innerHeight;
  for (const c of [cv, fxCv]) { c.width = W * DPR; c.height = H * DPR; }
  pctx.setTransform(DPR, 0, 0, DPR, 0, 0); fctx.setTransform(DPR, 0, 0, DPR, 0, 0);
}
addEventListener("resize", sizeFx);
sizeFx();

function burst(x, y, n = 20) {
  for (let i = 0; i < n && bits.length < 260; i++) {
    const ang = rnd(0, 6.283), sp = rnd(1.2, 5.2);
    bits.push({
      x, y, vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp - 1.2, life: 1, dec: rnd(.010, .022),
      rot: rnd(0, 6.28), vr: rnd(-.12, .12), s: rnd(8, 20), petal: Math.random() < .28,
      sp: Math.floor(rnd(0, PETAL_SPRITES.length)), si: Math.floor(rnd(0, 3)), flip: rnd(0, 6.28)
    });
  }
}
function trail(x, y) {
  if (bits.length > 240) return;
  bits.push({ x: x + rnd(-4, 4), y: y + rnd(-4, 4), vx: rnd(-.4, .4), vy: rnd(.1, .7), life: 1, dec: rnd(.025, .04), rot: rnd(0, 6.28), vr: rnd(-.05, .05), s: rnd(7, 13), petal: false, si: Math.floor(rnd(0, 3)) });
}
let lastTrail = { x: -99, y: -99 };
addEventListener("pointermove", e => {
  if (REDUCED || Math.hypot(e.clientX - lastTrail.x, e.clientY - lastTrail.y) < 18) return;
  lastTrail = { x: e.clientX, y: e.clientY }; trail(e.clientX, e.clientY);
});
addEventListener("pointerdown", e => burst(e.clientX, e.clientY, 14));

function fxStep(now) {
  const dt = Math.min((now - fxLast) / 16.667, 3); fxLast = now;
  const wind = Math.sin(now * .00022) * .35 + Math.sin(now * .0006 + 1) * .18;
  pctx.clearRect(0, 0, W, H); fctx.clearRect(0, 0, W, H);

  for (const s of stars) {
    s.ph += s.pv * dt; s.y += s.vy * dt; s.x += wind * .3 * dt; s.rot += .004 * dt;
    if (s.y > H + 20) Object.assign(s, newStar(false));
    const tw = (Math.sin(s.ph) + 1) / 2, a = tw * tw;
    if (a > .02) drawSprite(pctx, SPARKLES[s.si], s.x, s.y, s.s * (.35 + .65 * tw), s.rot, a * .95);
  }

  const br = boxRect;
  const bx = br.left + br.width / 2, by = br.top + br.height / 2, hx = br.width * .47;
  qrHide += ((view === "qr" ? 1 : 0) - qrHide) * Math.min(1, dt * .08);
  for (const w of words) {
    w.sway += w.sv * dt; w.y += w.vy * dt; w.x += (Math.sin(w.sway) * w.amp + wind * w.z) * dt;
    if (w.y > H + 70 || w.x < -150 || w.x > W + 150) Object.assign(w, newWord(false));
    const sw = w.sp.width * w.sc, sh = w.sp.height * w.sc;
    let a = w.a * Math.min(Math.max((w.y + 30) / 100, 0), Math.max((H + 30 - w.y) / 100, 0), 1);
    if (qrHide > .01) {
      const d = Math.max(Math.abs(w.x - bx) - hx - sw / 2, Math.abs(w.y - by) - hx - sh / 2);
      a *= 1 - qrHide * Math.max(0, Math.min(1, 1 - d / 50));
    }
    if (a < .01) continue;
    pctx.save();
    pctx.translate(w.x, w.y); pctx.rotate(Math.sin(w.sway + .6) * .35); pctx.globalAlpha = a;
    pctx.drawImage(w.sp, -sw / 2, -sh / 2, sw, sh);
    pctx.restore();
  }

  for (const p of petals) {
    p.sway += p.sv * dt; p.flip += p.fv * dt; p.tw += p.tv * dt;
    p.x += (Math.sin(p.sway) * p.amp + wind * p.z * 1.4) * dt; p.y += p.vy * dt;
    p.rot += (p.vr + Math.cos(p.sway) * .004 + wind * .002) * dt;
    if (p.y > H + 30) Object.assign(p, newPetal(false));
    else if (p.x < -40) p.x = W + 30; else if (p.x > W + 40) p.x = -30;

    const f = Math.cos(p.flip), d = p.s / .92;
    pctx.save();
    pctx.translate(p.x, p.y); pctx.rotate(p.rot + Math.sin(p.sway) * .5); pctx.scale(Math.max(.14, Math.abs(f)), 1);
    pctx.globalAlpha = p.a * (f < 0 ? .82 : 1);
    pctx.drawImage(PETAL_SPRITES[p.sp], -d / 2, -d / 2, d, d);
    pctx.restore();

    const gl = Math.pow(Math.max(0, Math.sin(p.tw)), 16);
    if (gl > .04 && p.z > .7) drawSprite(pctx, SPARKLES[p.si], p.x, p.y, p.s * (.8 + 1.6 * gl), p.rot * .5, gl);
  }

  for (let i = bits.length - 1; i >= 0; i--) {
    const b = bits[i];
    b.vx *= Math.pow(.965, dt); b.vy = b.vy * Math.pow(.965, dt) + .06 * dt;
    b.x += b.vx * dt; b.y += b.vy * dt; b.rot += b.vr * dt; b.life -= b.dec * dt;
    if (b.life <= 0) { bits.splice(i, 1); continue; }
    const a = Math.min(1, b.life * 1.6);
    if (b.petal) {
      b.flip += .12 * dt; const d = b.s / .92;
      fctx.save(); fctx.translate(b.x, b.y); fctx.rotate(b.rot); fctx.scale(Math.max(.2, Math.abs(Math.cos(b.flip))), 1);
      fctx.globalAlpha = a; fctx.drawImage(PETAL_SPRITES[b.sp], -d / 2, -d / 2, d, d); fctx.restore();
    } else {
      drawSprite(fctx, SPARKLES[b.si], b.x, b.y, b.s * (.5 + .5 * b.life), b.rot, a * (.7 + .3 * Math.sin(b.life * 40)));
    }
  }
}
</script>
</body>
</html>

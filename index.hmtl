<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#fff0f6">
<title>Thiệp Tri Ân Thầy Cô · 20/11</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link id="gf" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Dancing+Script:wght@600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap&subset=vietnamese" rel="stylesheet" media="print" onload="this.media='all';this.dataset.loaded=1">
<noscript><link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Dancing+Script:wght@600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap&subset=vietnamese" rel="stylesheet"></noscript>
<style>

:root {
  --pink: #ff4f8b;
  --blue: #3b8bff;
  --blue-deep: #1d4ed8;

  --e-back: #f08fba; --e-fl: #f9c0da; --e-fr: #f5a9cc; --e-fb: #e57aa8; --e-flap: #b79cf0; --e-seal: #d9588a;
  --ink: #4a2038;
  --ease: cubic-bezier(.4, 0, .2, 1);
  --ease-soft: cubic-bezier(.45, .05, .2, 1);
  --font-body: "Be Vietnam Pro", "Segoe UI", Roboto, Arial, sans-serif;
  --font-title: "Playfair Display", Georgia, "Times New Roman", serif;
  --font-script: "Dancing Script", "Segoe Script", cursive;
}
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { height: 100%; margin: 0; overscroll-behavior: none; -webkit-text-size-adjust: 100%; }
body {
  font-family: var(--font-body);
  color: var(--ink);
  overflow: hidden;
  background:
    radial-gradient(circle at 15% 10%, #ffd6e7 0, transparent 45%),
    radial-gradient(circle at 85% 90%, #cfe6ff 0, transparent 45%),
    linear-gradient(160deg, #fff4f8, #f0f7ff);
}
#petals, #fx { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; }
#fx { z-index: 20; }

main {
  position: relative; z-index: 1; height: 100vh; height: 100svh;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: env(safe-area-inset-top, 0) 12px env(safe-area-inset-bottom, 0);
}
.title { text-align: center; margin-bottom: 4px; }
.kicker { font-size: 11px; font-weight: 600; letter-spacing: 3px; color: var(--blue-deep); }
h1 { font: italic 600 clamp(30px, 8vw, 46px)/1.15 var(--font-title); margin: 6px 0 0; }
h1 span { color: var(--pink); }
.caption { transition: opacity .35s var(--ease), transform .35s var(--ease); min-height: 36px; max-width: 360px; padding: 0 14px; line-height: 1.4; margin: 6px 0 0; font-size: 13px; font-weight: 500; color: var(--blue-deep); text-align: center; }

.caption.out { opacity: 0; transform: translateY(4px); }

.stage-wrap { width: 340px; height: 540px; }
.stage { width: 340px; height: 540px; position: relative; transform-origin: top left; }
.box { position: absolute; left: 10px; top: 100px; width: 320px; height: 340px; cursor: pointer; outline: none; }
.float { position: relative; width: 100%; height: 100%; will-change: transform; }

#cells { will-change: transform; position: absolute; left: -40px; top: -50px; width: 400px; height: 440px; transition: opacity .9s var(--ease); }
.formed #cells { opacity: 0; pointer-events: none; }

.env { position: absolute; left: 0; top: 65px; width: 320px; height: 210px; opacity: 0; pointer-events: none; perspective: 900px; transition: opacity .9s var(--ease); }
.formed .env { opacity: 1; pointer-events: auto; }
.env-back { position: absolute; inset: 0; border-radius: 10px; background: linear-gradient(180deg, #ffffff2e, #0000), var(--e-back); box-shadow: 0 22px 40px #0002; transition: opacity .8s var(--ease) .3s; }
.env-front { position: absolute; inset: 0; z-index: 3; border-radius: 10px; overflow: hidden; transition: opacity .8s var(--ease) .3s; }
.fold { position: absolute; inset: 0; }
.fold-l { clip-path: polygon(0 0, 52% 54%, 0 100%); background: linear-gradient(90deg, #ffffff30, #0000), var(--e-fl); }
.fold-r { clip-path: polygon(100% 0, 48% 54%, 100% 100%); background: linear-gradient(270deg, #ffffff22, #0000), var(--e-fr); }
.fold-b { clip-path: polygon(0 100%, 50% 46%, 100% 100%); background: linear-gradient(180deg, #ffffff1a, #00000026), var(--e-fb); }
.stamp {
  position: absolute; right: 16px; bottom: 14px; padding: 4px 8px; border: 1.5px dashed #ffffffcc; border-radius: 4px;
  font: 600 10px var(--font-body); letter-spacing: 1px; color: #fff; text-shadow: 0 1px 2px #0003; transform: rotate(-6deg);
}
.flap {
  position: absolute; left: 0; top: 0; width: 100%; height: 60%; z-index: 4;
  clip-path: polygon(0 0, 100% 0, 50% 100%); transform-origin: top;
  background: linear-gradient(180deg, #ffffff45, #0000 65%), var(--e-flap);
  transition: transform .9s var(--ease-soft) .7s, z-index 0s 1.1s, opacity .8s var(--ease) .3s;
}
.seal {
  position: absolute; left: 50%; top: 54%; z-index: 5; width: 46px; height: 46px; margin: -23px 0 0 -23px;
  display: grid; place-items: center; border-radius: 50%; font-size: 22px; color: #fff;
  background: radial-gradient(circle at 35% 30%, #ffffff66, #0000 60%), var(--e-seal); box-shadow: 0 4px 10px #0004, inset 0 0 0 3px #ffffff33, inset 0 -3px 5px #0003;
  transition: opacity .4s 1.2s;
}

.letter-clip { position: absolute; inset: 0; z-index: 2; clip-path: inset(-1000px -40px 0 -40px); transition: clip-path 1s var(--ease-soft), z-index 0s; }
.letter {
  position: absolute; left: 10px; bottom: 12px; width: 300px; height: 480px;
  background: #fffdf8; border-radius: 6px; border-top: 5px solid var(--e-flap); padding: 14px 18px 22px; overflow: hidden; text-align: center;
  box-shadow: 0 -4px 14px #0001; transform: translateY(430px);
  transition: transform 1.1s var(--ease-soft);
}
.letter .orn { font-size: 20px; color: var(--e-seal); margin-bottom: 2px; }
.letter h2 { font: 600 24px/1.2 var(--font-title); margin: 0 0 4px; }
.letter h2 em { color: var(--pink); }
.letter .msg { margin-top: 12px; font-size: 12.5px; line-height: 1.75; text-align: left; white-space: pre-line; }
.letter .sign { font: 600 20px var(--font-script); color: var(--pink); margin-top: 12px; }

[data-view="open"] .flap { transform: rotateX(180deg); z-index: 1; transition: transform .9s var(--ease-soft) .25s, z-index 0s .6s, opacity .8s var(--ease); }
[data-view="open"] .seal { opacity: 0; transition: opacity .25s; }
[data-view="open"] .letter { transform: translateY(200px); transition: transform 1.2s cubic-bezier(.22, .8, .3, 1) .85s; }
[data-view="open"].read .letter-clip { z-index: 6; clip-path: inset(-1000px -40px -300px -40px); transition: clip-path 1.1s var(--ease-soft), z-index 0s .9s; }
[data-view="open"].read .letter { transform: translateY(140px); transition: transform 1.2s var(--ease-soft); overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; box-shadow: 0 18px 40px #3b82f64d; }
[data-view="open"]:not(.read) .env { cursor: pointer; }
[data-view="open"]:not(.read) .letter { animation: nudge 1.8s ease-in-out 1.8s infinite; }
@keyframes nudge { 0%, 100% { box-shadow: 0 -4px 14px #0001; } 50% { box-shadow: 0 -6px 24px #ff4f8b99; } }
[data-view="open"].read .env-back, [data-view="open"].read .env-front, [data-view="open"].read .flap { opacity: 0; transition: opacity 1s var(--ease); }

.back-btn, .open-btn {
  position: absolute; left: 50%; bottom: 0; transform: translate(-50%, 10px); opacity: 0; pointer-events: none;
  padding: 10px 22px; border: 0; border-radius: 99px; color: #fff; cursor: pointer;
  font: 600 12px var(--font-body); letter-spacing: 1px; background: linear-gradient(90deg, var(--pink), #ff7aa8);
  box-shadow: 0 8px 18px #ff4f8b55; transition: opacity .25s var(--ease), transform .25s var(--ease);
}
[data-view="open"] .back-btn, .ready .open-btn { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; transition: opacity .7s var(--ease) .8s, transform .7s var(--ease) .8s; }
.open-btn:hover, .back-btn:hover { filter: brightness(1.06); }
.box, .open-btn, .back-btn { touch-action: manipulation; -webkit-user-select: none; user-select: none; }
@media (pointer: coarse) { .open-btn, .back-btn { padding: 13px 28px; font-size: 13px; } }
@media (max-height: 520px) {
  .kicker { display: none; }
  h1 { font-size: 24px; margin: 0; }
  .caption { min-height: 18px; font-size: 12px; margin: 2px 0 0; }
}
#fallback { display: none; position: fixed; inset: 0; z-index: 50; flex-direction: column; align-items: center; justify-content: center; gap: 18px; padding: 24px; text-align: center; background: linear-gradient(160deg, #ffe3ee, #e3f0ff); color: var(--ink); font: 14px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
#fallback.show { display: flex; }
#fallback img { width: min(78vw, 340px); height: auto; image-rendering: pixelated; background: #fff; padding: 10px; border-radius: 14px; box-shadow: 0 10px 30px #3b82f640; }
#fallback h2 { margin: 0; font-size: 20px; }
#fallback p { margin: 0; max-width: 340px; }
</style>
</head>
<body>
<canvas id="petals"></canvas>
<canvas id="fx"></canvas>
<div id="fallback">
  <h2>Tri ân Thầy Cô ♡</h2>
  <img id="fbQR" alt="Mã QR lời chúc" src="data:image/png;base64,">
  <p>Quét mã QR bằng camera điện thoại để đọc lời chúc.<br>Để xem thiệp đầy đủ hiệu ứng, hãy mở bằng Safari hoặc Chrome.</p>
</div>
<noscript><style>#fallback { display: flex; }</style></noscript>
<script>
(function () {
  function show() { var f = document.getElementById("fallback"); if (f && !window.__drawn) f.className = "show"; }
  window.addEventListener("error", function () { setTimeout(show, 800); });
  setTimeout(show, 3500);
})();
</script>

<main>
  <header class="title">
    <div class="kicker">✿ NGÀY NHÀ GIÁO VIỆT NAM 20/11 ✿</div>
    <h1>Tri ân <span>Thầy Cô</span></h1>
    <p class="caption" id="caption"></p>
  </header>

  <div class="stage-wrap" id="wrap">
    <div class="stage" id="stage" data-view="qr">
      <div class="box" id="box" role="button" tabindex="0" aria-label="Chạm để các ô QR gộp thành thư, chạm lần nữa để mở thư">
        <div class="float">
          <canvas id="cells"></canvas>
          <div class="env">
            <div class="env-back"></div>
            <div class="letter-clip"><div class="letter">
              <div class="orn">❀</div>
              <h2>Kính gửi <em>Thầy Cô</em></h2>
              <div class="msg" id="msg"></div>
              <div class="sign">Với tất cả sự kính trọng ♡</div>
            </div></div>
            <div class="env-front"><div class="fold fold-b"></div><div class="fold fold-l"></div><div class="fold fold-r"></div><div class="stamp">20·11 ✿</div></div>
            <div class="flap"></div>
            <div class="seal">♡</div>
          </div>
        </div>
      </div>
      <button class="open-btn" id="openBtn">✉ MỞ THƯ</button>
      <button class="back-btn" id="backBtn">↶ ĐÓNG THƯ</button>
    </div>
  </div>
</main>

<script>
(function(){
var defs = {}, cache = {};
function req(n){ n = n.replace("./",""); if (!cache[n]) { var m = { exports: {} }; cache[n] = m; defs[n](m, m.exports, req); } return cache[n].exports; }
defs["QRMode"] = function(module, exports, req){
module.exports = {
    MODE_NUMBER :       1 << 0,
    MODE_ALPHA_NUM :    1 << 1,
    MODE_8BIT_BYTE :    1 << 2,
    MODE_KANJI :        1 << 3
};
};
defs["QRErrorCorrectLevel"] = function(module, exports, req){
module.exports = {
	L : 1,
	M : 0,
	Q : 3,
	H : 2
};
};
defs["QRMaskPattern"] = function(module, exports, req){
module.exports = {
	PATTERN000 : 0,
	PATTERN001 : 1,
	PATTERN010 : 2,
	PATTERN011 : 3,
	PATTERN100 : 4,
	PATTERN101 : 5,
	PATTERN110 : 6,
	PATTERN111 : 7
};
};
defs["QRMath"] = function(module, exports, req){
var QRMath = {
	glog : function(n) {
		if (n < 1) {
			throw new Error("glog(" + n + ")");
		}
		return QRMath.LOG_TABLE[n];
	},
	gexp : function(n) {
		while (n < 0) {
			n += 255;
		}
		while (n >= 256) {
			n -= 255;
		}
		return QRMath.EXP_TABLE[n];
	},
	EXP_TABLE : new Array(256),
	LOG_TABLE : new Array(256)
};
for (var i = 0; i < 8; i++) {
	QRMath.EXP_TABLE[i] = 1 << i;
}
for (var i = 8; i < 256; i++) {
	QRMath.EXP_TABLE[i] = QRMath.EXP_TABLE[i - 4]
		^ QRMath.EXP_TABLE[i - 5]
		^ QRMath.EXP_TABLE[i - 6]
		^ QRMath.EXP_TABLE[i - 8];
}
for (var i = 0; i < 255; i++) {
	QRMath.LOG_TABLE[QRMath.EXP_TABLE[i] ] = i;
}
module.exports = QRMath;
};
defs["QRPolynomial"] = function(module, exports, req){
var QRMath = req('./QRMath');
function QRPolynomial(num, shift) {
	if (num.length === undefined) {
		throw new Error(num.length + "/" + shift);
	}
	var offset = 0;
	while (offset < num.length && num[offset] === 0) {
		offset++;
	}
	this.num = new Array(num.length - offset + shift);
	for (var i = 0; i < num.length - offset; i++) {
		this.num[i] = num[i + offset];
	}
}
QRPolynomial.prototype = {
	get : function(index) {
		return this.num[index];
	},
	getLength : function() {
		return this.num.length;
	},
	multiply : function(e) {
		var num = new Array(this.getLength() + e.getLength() - 1);
		for (var i = 0; i < this.getLength(); i++) {
			for (var j = 0; j < e.getLength(); j++) {
				num[i + j] ^= QRMath.gexp(QRMath.glog(this.get(i) ) + QRMath.glog(e.get(j) ) );
			}
		}
		return new QRPolynomial(num, 0);
	},
	mod : function(e) {
		if (this.getLength() - e.getLength() < 0) {
			return this;
		}
		var ratio = QRMath.glog(this.get(0) ) - QRMath.glog(e.get(0) );
		var num = new Array(this.getLength() );
		for (var i = 0; i < this.getLength(); i++) {
			num[i] = this.get(i);
		}
		for (var x = 0; x < e.getLength(); x++) {
			num[x] ^= QRMath.gexp(QRMath.glog(e.get(x) ) + ratio);
		}
		return new QRPolynomial(num, 0).mod(e);
	}
};
module.exports = QRPolynomial;
};
defs["QRRSBlock"] = function(module, exports, req){
var QRErrorCorrectLevel = req('./QRErrorCorrectLevel');
function QRRSBlock(totalCount, dataCount) {
	this.totalCount = totalCount;
	this.dataCount  = dataCount;
}
QRRSBlock.RS_BLOCK_TABLE = [
	[1, 26, 19],
	[1, 26, 16],
	[1, 26, 13],
	[1, 26, 9],
	[1, 44, 34],
	[1, 44, 28],
